# Python virtual environments
.venv/
venv/

# Python caches and test artefacts
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/
# pytest.ini pins --basetemp here. pytest creates the leaf but not its parent,
# so the directory itself has to survive a clone or every tmp_path test errors.
tmp/*
!tmp/.gitkeep

# IDE and operating-system files
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Local runtime output
data/input/*
!data/input/.gitkeep
!data/input/pla_white_filament.jpg
!data/input/plastic_surface_texture.jpg
!data/input/scratched_dirty_plastic.jpg
data/output/*
!data/output/.gitkeep
# Appendix A of the proposal report cites these two machine-readable traces as
# formal evidence records [42] and [43]. They must stay in the repository or the
# report's evidence chain points at files nobody else can obtain.
!data/output/latency/
!data/output/network_fault/
logs/

# Course materials (Monash copyright): kept locally, never published
ENG5105-ENG5106 S2 2026 - Project Briefs_Rev0.pdf
Electrical teams proposal report rubric 2026.pdf
ENG5105 Components - With pictures 2026.pdf
Concept design_ Discipline specific content.docx.pdf
